# ──────────────────────────────────────────────
# Sentinel — Environment Variables
# Copy this file to .env and fill in real values.
# ──────────────────────────────────────────────

# --- Application ---
APP_NAME=Sentinel
APP_ENV=development
DEBUG=true
DRY_RUN=true

# --- Database (Local PostgreSQL on Windows) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sentinel

# --- Redis (Memurai on Windows) ---
REDIS_URL=redis://localhost:6379/0

# --- Twilio (SMS / Voice) ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# --- Firebase Cloud Messaging ---
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# --- AWS S3 (Evidence Storage) ---
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_EVIDENCE_BUCKET=sentinel-evidence

# --- Escalation ---
ESCALATION_SLA_SECONDS=60

# --- CORS (Next.js frontend) ---
CORS_ORIGINS=["http://localhost:3000"]
